# Neon Database ConnectionNEON_DB_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/niche_intelligence?sslmode=require# Anthropic Claude API (for brain processing)ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx# Reddit API (PRAW - Python Reddit API Wrapper)REDDIT_CLIENT_ID=your_reddit_client_id_hereREDDIT_CLIENT_SECRET=your_reddit_client_secret_hereREDDIT_USER_AGENT=NicheIntelligenceBot/1.0# Google Trends (No API key required - using pytrends library)# Just install: pip3 install pytrends# YouTube Data API (optional - for comment scraping)YOUTUBE_API_KEY=your_youtube_api_key_here# AdBeat API (optional - paid service for competitor ad data)ADBEAT_API_KEY=your_adbeat_api_key_here# Google Search Console (optional - requires OAuth setup)GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your_client_idGOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your_client_secret# ============================================# SETUP INSTRUCTIONS# ============================================# 1. NEON DATABASE:#    - Go to: https://neon.tech#    - Create account (free tier)#    - Create new project: "Niche Intelligence"#    - Copy connection string#    - Paste above# 2. ANTHROPIC API:#    - Go to: https://console.anthropic.com#    - Generate API key#    - Paste above#    - Note: We'll mostly use Claude Desktop (free with Pro)#    - API key only needed if processing large batches programmatically# 3. REDDIT API:#    - Go to: https://www.reddit.com/prefs/apps#    - Click "Create App" or "Create Another App"#    - Name: Niche Intelligence Bot#    - Type: Script#    - Redirect URI: http://localhost:8080#    - Copy client ID and secret#    - User Agent: Any descriptive string# 4. GOOGLE TRENDS:#    - No API key needed#    - Just install: pip3 install pytrends#    - Free to use# 5. YOUTUBE API (Optional):#    - Go to: https://console.cloud.google.com#    - Enable YouTube Data API v3#    - Create credentials#    - Copy API key# 6. ADBEAT (Optional - Paid):#    - Go to: https://www.adbeat.com#    - Sign up for paid plan ($250-500/month)#    - Get API key from account settings# ============================================# USAGE IN PYTHON SCRIPTS# ============================================# import os# from dotenv import load_dotenv# # load_dotenv()# # NEON_DB_URL = os.getenv('NEON_DB_URL')# REDDIT_CLIENT_ID = os.getenv('REDDIT_CLIENT_ID')# # etc...# ============================================# USAGE IN MCP SERVER (Node.js/TypeScript)# ============================================# import * as dotenv from 'dotenv';# dotenv.config();# # const NEON_DB_URL = process.env.NEON_DB_URL;# const ANTHROPIC_API_KEY = process.env.ANTHROPIC_API_KEY;# // etc...# ============================================# SECURITY NOTES# ============================================# - NEVER commit this file with real credentials to GitHub# - Add .env to .gitignore# - Copy this file to .env and fill in real values# - Store production credentials securely (e.g., Vercel env vars, 1Password)# ============================================# TO USE THIS FILE:# ============================================# 1. Copy this file:#    cp env-template.txt .env## 2. Fill in your actual credentials in .env## 3. Add .env to .gitignore:#    echo ".env" >> .gitignore